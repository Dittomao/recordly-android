<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer is loaded from a loopback HTTP server; this permission is
         required for any socket, including 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The floating recorder. Optional: without it the app uses the in-app HUD. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Returning to the app after a take: the recording is captured while the
         user is elsewhere, and `moveTaskToFront` on our own task is the only
         way back that Android 10+ still allows without user interaction. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Recordly">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares app-private files with the app the user opens them in.
             "Reveal in folder" has no Android equivalent, so the closest
             honest behaviour is opening the file itself; that needs a
             content:// URI, because app storage is not readable by anyone
             else. The declared paths are limited to the media root, which is
             what the app itself produces. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MediaProjection capture. It must be a foreground service of type
             `mediaProjection`: on API 34+ the projection token is single-use
             and tied to a foreground service, and starting the service without
             this type is refused. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Observe-only tap telemetry for auto-zoom. It never consumes input:
             `setMotionEventSources` is what would take touches from the app
             being recorded, and it is deliberately not used (PORTING-PLAN §4.3). -->
        <service
            android:name=".TelemetryAccessibilityService"
            android:exported="true"
            android:label="@string/telemetry_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/telemetry_accessibility" />
        </service>

    </application>

</manifest>
