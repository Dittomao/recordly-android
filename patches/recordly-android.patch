diff --git a/src/components/video-editor/dashboard/Dashboard.mobile.css b/src/components/video-editor/dashboard/Dashboard.mobile.css
new file mode 100644
index 0000000..b9880b6
--- /dev/null
+++ b/src/components/video-editor/dashboard/Dashboard.mobile.css
@@ -0,0 +1,69 @@
+/*
+ * Phone layout for the project dashboard.
+ *
+ * Desktop splits the body into a 192px navigation column and the project card;
+ * at 411px that leaves the card 207px wide, which wraps "Your projects" and
+ * squeezes every card. On phones the navigation becomes a slide-over drawer and
+ * the card spans the viewport.
+ */
+.dashboard-nav-toggle,
+.dashboard-sidebar-close {
+	display: none;
+}
+
+@media (max-width: 900px) {
+	.dashboard-shell .loading-content-enter {
+		flex-direction: column;
+	}
+
+	.dashboard-shell .loading-content-enter > .card {
+		margin: 8px;
+		width: auto;
+		flex: 1 1 auto;
+	}
+
+	.dashboard-nav-toggle {
+		display: inline-flex;
+	}
+
+	.dashboard-sidebar {
+		position: fixed;
+		left: 0;
+		top: 56px;
+		bottom: 0;
+		z-index: 60;
+		width: min(280px, 82vw);
+		padding-top: 3rem;
+		background: var(--background);
+		box-shadow: 12px 0 30px rgb(0 0 0 / 0.25);
+	}
+
+	.dashboard-sidebar[data-mobile-open="false"] {
+		display: none;
+	}
+
+	.dashboard-sidebar-close {
+		display: inline-flex;
+		position: absolute;
+		top: 8px;
+		right: 8px;
+		z-index: 61;
+	}
+
+	.dashboard-sidebar-backdrop {
+		display: block;
+		position: fixed;
+		inset: 56px 0 0 0;
+		z-index: 55;
+		background: rgb(0 0 0 / 0.35);
+		border: 0;
+		padding: 0;
+	}
+
+	/* The dashboard header has Library + Resume; squeeze the Resume label so
+	   both fit beside the new navigation button. */
+	.dashboard-shell > .app-frame-header .loading-content-enter,
+	.dashboard-shell > .app-frame-header {
+		min-width: 0;
+	}
+}
