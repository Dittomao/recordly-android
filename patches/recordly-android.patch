diff --git a/src/components/video-editor/onboarding/TapSwoopOnboarding.css b/src/components/video-editor/onboarding/TapSwoopOnboarding.css
new file mode 100644
index 0000000..7167416
--- /dev/null
+++ b/src/components/video-editor/onboarding/TapSwoopOnboarding.css
@@ -0,0 +1,1096 @@
+/*
+ * TapSwoop first-run tour.
+ *
+ * The tour is a page, not a stack of cards: one narrow column on the device,
+ * with the app's own stage, timeline and labels carrying each idea. Motion is
+ * deliberately small (opacity and transform) and removed under Reduce Motion.
+ */
+
+.modal__backdrop.cut-onboarding-overlay {
+	/* Above the dashboard's full-page modal, which HeroUI opens at 100000. */
+	z-index: 100100;
+	background: var(--background, #e7eef0);
+}
+
+.modal__container.cut-onboarding-container {
+	width: 100%;
+	max-width: none;
+	height: 100%;
+	padding: 0;
+}
+
+.cut-room.cut-onboarding {
+	position: relative;
+	display: flex;
+	flex-direction: column;
+	width: 100%;
+	height: 100%;
+	max-height: none;
+	min-height: 0;
+	padding: 0;
+	overflow: hidden;
+	border: 0;
+	border-radius: 0;
+	background: var(--cut-ground);
+	box-shadow: none;
+	outline: none;
+}
+
+.cut-onboarding-header {
+	display: flex;
+	flex: 0 0 58px;
+	align-items: center;
+	justify-content: space-between;
+	gap: 8px;
+	padding: 0 12px 0 18px;
+}
+
+.cut-onboarding-brand {
+	display: flex;
+	min-width: 0;
+	align-items: center;
+	gap: 8px;
+	color: var(--cut-ink);
+	font-size: 18px;
+	font-weight: 800;
+	letter-spacing: -.04em;
+}
+
+.cut-onboarding-mark {
+	width: 24px;
+	height: 24px;
+	color: var(--cut-accent);
+}
+
+.cut-onboarding-header-actions {
+	display: flex;
+	align-items: center;
+	gap: 2px;
+}
+
+.cut-onboarding-count {
+	padding-inline-end: 8px;
+	color: var(--cut-muted);
+	font-size: 12px;
+	font-variant-numeric: tabular-nums;
+}
+
+.cut-onboarding-progress {
+	flex: 0 0 3px;
+	margin: 0 18px;
+	overflow: hidden;
+	border-radius: 3px;
+	background: var(--cut-rule);
+}
+
+.cut-onboarding-progress span {
+	display: block;
+	width: 100%;
+	height: 100%;
+	border-radius: inherit;
+	background: var(--cut-accent);
+	transform-origin: 0 50%;
+	transition: transform 280ms cubic-bezier(.22, 1, .36, 1);
+}
+
+.cut-onboarding-scroll {
+	display: flex;
+	flex: 1 1 auto;
+	min-height: 0;
+	flex-direction: column;
+	padding: 14px 16px 6px;
+	overflow-y: auto;
+	overscroll-behavior: contain;
+	scrollbar-width: none;
+}
+
+.cut-onboarding-scroll::-webkit-scrollbar {
+	display: none;
+}
+
+.cut-onboarding-page {
+	display: flex;
+	width: 100%;
+	max-width: 560px;
+	min-height: min-content;
+	margin: auto;
+	flex: 0 0 auto;
+	flex-direction: column;
+}
+
+.cut-onboarding-stage {
+	position: relative;
+	flex: 0 0 clamp(196px, 30dvh, 262px);
+	overflow: hidden;
+	border: 1px solid color-mix(in srgb, var(--cut-accent) 22%, var(--cut-stage));
+	border-radius: 18px;
+	background: var(--cut-stage);
+	isolation: isolate;
+}
+
+.cut-onboarding[data-page="3"] .cut-onboarding-stage {
+	flex-basis: clamp(164px, 24dvh, 206px);
+}
+
+.cut-onboarding-stage::before {
+	position: absolute;
+	inset: 0;
+	z-index: -1;
+	background: color-mix(in srgb, var(--cut-accent) 7%, transparent);
+	content: "";
+}
+
+.cut-onboarding-stage::after {
+	position: absolute;
+	right: 16px;
+	bottom: 12px;
+	left: 16px;
+	height: 1px;
+	background: color-mix(in srgb, var(--cut-accent) 22%, transparent);
+	content: "";
+}
+
+.cut-demo {
+	position: absolute;
+	inset: 0;
+	display: grid;
+	place-items: center;
+	padding: 16px;
+}
+
+.cut-demo-phone {
+	position: relative;
+	display: flex;
+	width: 138px;
+	height: 190px;
+	flex-direction: column;
+	overflow: hidden;
+	border: 3px solid #0d1b1f;
+	border-radius: 16px;
+	background: var(--cut-sheet);
+	box-shadow: 0 10px 26px #0000003d;
+	color: var(--cut-ink);
+}
+
+.cut-demo-speaker {
+	position: absolute;
+	top: 5px;
+	left: 50%;
+	width: 22px;
+	height: 4px;
+	border-radius: 4px;
+	background: #0d1b1f;
+	transform: translateX(-50%);
+}
+
+.cut-demo-appbar {
+	display: flex;
+	align-items: center;
+	gap: 5px;
+	padding: 15px 9px 6px;
+	color: var(--cut-muted);
+	font-size: 7px;
+	font-weight: 700;
+}
+
+.cut-demo-appbar-dot {
+	width: 7px;
+	height: 7px;
+	border-radius: 50%;
+	background: var(--cut-accent);
+}
+
+.cut-demo-appbar-menu {
+	margin-inline-start: auto;
+	font-size: 9px;
+	letter-spacing: 1px;
+}
+
+.cut-demo-content {
+	display: flex;
+	min-height: 0;
+	flex: 1;
+	flex-direction: column;
+	gap: 8px;
+	padding: 0 11px 12px;
+}
+
+.cut-demo-title {
+	margin: 2px 0 0;
+	color: var(--cut-ink);
+	font-size: 11px;
+	font-weight: 800;
+	line-height: 1.2;
+}
+
+.cut-demo-rows {
+	display: flex;
+	flex-direction: column;
+	gap: 7px;
+}
+
+.cut-demo-rows span {
+	display: block;
+	width: 100%;
+	height: 6px;
+	border-radius: 3px;
+	background: color-mix(in srgb, var(--cut-ink) 12%, transparent);
+}
+
+.cut-demo-rows span.is-short {
+	width: 64%;
+}
+
+.cut-demo-rows span:nth-child(2n) {
+	width: 82%;
+}
+
+.cut-demo-record .cut-demo-phone-record {
+	transform: translate(-30px, -2px) rotate(-2deg);
+}
+
+.cut-demo-hud {
+	position: absolute;
+	right: 20px;
+	bottom: 24px;
+	display: flex;
+	min-width: 142px;
+	align-items: center;
+	gap: 8px;
+	padding: 7px 9px;
+	border: 1px solid var(--cut-rule);
+	border-radius: 12px;
+	background: var(--cut-sheet);
+	box-shadow: 0 8px 22px #00000038;
+	color: var(--cut-ink);
+}
+
+.cut-demo-record-dot {
+	position: relative;
+	display: grid;
+	width: 28px;
+	height: 28px;
+	flex: 0 0 28px;
+	place-items: center;
+	border-radius: 50%;
+	background: var(--cut-record-color, #d1293b);
+}
+
+.cut-demo-record-dot span {
+	width: 12px;
+	height: 12px;
+	border-radius: 50%;
+	background: #fff;
+}
+
+.cut-demo-record-dot::after {
+	position: absolute;
+	inset: -4px;
+	border: 2px solid #e14755;
+	border-radius: 50%;
+	animation: cut-onboarding-pulse 2.4s ease-out infinite;
+	content: "";
+}
+
+.cut-demo-hud-copy {
+	display: flex;
+	min-width: 0;
+	flex: 1;
+	flex-direction: column;
+	line-height: 1.15;
+}
+
+.cut-demo-hud-copy strong {
+	font-size: 11px;
+	font-weight: 800;
+}
+
+.cut-demo-hud-copy small {
+	color: var(--cut-muted);
+	font-size: 8px;
+}
+
+.cut-demo-hud-clock {
+	color: var(--cut-muted);
+	font-size: 9px;
+	font-variant-numeric: tabular-nums;
+}
+
+.cut-demo-floating-tag {
+	position: absolute;
+	top: 16px;
+	left: 18px;
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	padding: 6px 9px;
+	border: 1px solid #ffffff1f;
+	border-radius: 7px;
+	background: #ffffff0d;
+	color: #dcebed;
+	font-size: 10px;
+	font-weight: 700;
+}
+
+.cut-demo-live-dot {
+	width: 6px;
+	height: 6px;
+	border-radius: 50%;
+	background: #ff5b68;
+	animation: cut-onboarding-live 2.4s ease-out infinite;
+}
+
+.cut-demo-phone-focus {
+	width: 146px;
+	height: 198px;
+	transform: translate(-22px, 3px);
+}
+
+.cut-demo-phone-focus .cut-demo-content {
+	gap: 0;
+	padding: 1px 8px 0;
+}
+
+.cut-demo-focus-row {
+	display: flex;
+	align-items: center;
+	gap: 7px;
+	min-height: 34px;
+	border-bottom: 1px solid var(--cut-rule);
+	color: var(--cut-muted);
+	font-size: 8px;
+	font-weight: 650;
+}
+
+.cut-demo-focus-row:last-child {
+	border-bottom: 0;
+}
+
+.cut-demo-check {
+	width: 10px;
+	height: 10px;
+	flex: 0 0 10px;
+	border: 1px solid var(--cut-rule);
+	border-radius: 3px;
+	background: var(--cut-inset);
+}
+
+.cut-demo-focus-row.is-target {
+	color: var(--cut-ink);
+}
+
+.cut-demo-focus-row.is-target .cut-demo-check {
+	border-color: var(--cut-accent);
+	background: var(--cut-accent);
+}
+
+.cut-demo-toggle {
+	position: relative;
+	width: 22px;
+	height: 12px;
+	margin-inline-start: auto;
+	border-radius: 12px;
+	background: var(--cut-accent);
+}
+
+.cut-demo-toggle > span {
+	position: absolute;
+	top: 2px;
+	right: 2px;
+	width: 8px;
+	height: 8px;
+	border-radius: 50%;
+	background: #fff;
+}
+
+.cut-demo-crop {
+	position: absolute;
+	top: 75px;
+	left: 17px;
+	width: 108px;
+	height: 40px;
+	border: 2px solid var(--cut-accent);
+	border-radius: 7px;
+	animation: cut-onboarding-crop 4.8s cubic-bezier(.22, 1, .36, 1) infinite;
+}
+
+.cut-demo-tap {
+	position: absolute;
+	top: 84px;
+	right: 10px;
+	width: 22px;
+	height: 22px;
+	border: 2px solid #2563eb;
+	border-radius: 50%;
+	animation: cut-onboarding-tap 2.4s ease-out infinite;
+}
+
+.cut-demo-tap::after {
+	position: absolute;
+	inset: -8px;
+	border: 1.5px solid #2563eb;
+	border-radius: 50%;
+	animation: cut-onboarding-tap 2.4s 260ms ease-out infinite;
+	content: "";
+}
+
+.cut-demo-zoom-badge {
+	position: absolute;
+	right: 25px;
+	bottom: 28px;
+	padding: 5px 8px;
+	border-radius: 6px;
+	background: var(--cut-accent);
+	color: var(--cut-ground);
+	font-size: 11px;
+	font-weight: 850;
+	font-variant-numeric: tabular-nums;
+}
+
