+import { FunnelSimple } from "@phosphor-icons/react";
+import { useId, useState } from "react";
+import { CutRoomRecordButton } from "@/components/ui/CutRoomRecordButton";
+import { Button } from "@/components/ui/button";
+import { DownloadSimple, MagnifyingGlass } from "@/components/ui/icons";
+import { useI18n } from "@/contexts/I18nContext";
+import { DashboardFilters } from "./DashboardFilters";
+import type { DashboardProps } from "./types";
+import type { DashboardModel } from "./useDashboardModel";
+
+// From Uiverse.io by vinodjangid07 - https://uiverse.io/vinodjangid07/smart-emu-83
+// MIT License, Copyright (c) vinodjangid07 (Vinod Jangid)
+export function CutRoomLibraryIntro({
+	busy,
+	run,
+	onImportFile,
+	activeFolder,
+}: Pick<DashboardModel, "busy" | "run" | "activeFolder"> & Pick<DashboardProps, "onImportFile">) {
+	const { t } = useI18n();
+	const [revealing, setRevealing] = useState(false);
+	// Do not route the early show through `run`: setting the dashboard busy
+	// during the pointer sequence disables this button before its click and
+	// can leave the reveal stuck. The overlay owns its own error fallback.
+	const record = () => {
+		void window.electronAPI.showRecordingHud().catch(() => undefined);
+	};
+	const recordLabel = t("ui.cutRoom.newRecording", "New recording");
+	return (
+		<div className="cut-library-intro">
+			<h1>{activeFolder?.name ?? t("ui.cutRoom.projectLibrary", "Project library")}</h1>
+			<p>{t("ui.cutRoom.localLibrary", "Screen recordings and edits on this device.")}</p>
+			<div className="cut-home-actions">
+				<CutRoomRecordButton
+					label={recordLabel}
+					disabled={busy}
+					// Start the overlay on the press, while the button is still
+					// revealing. The activation itself does nothing else: the
+					// compact pill waits for its own tap before expanding.
+					onReveal={record}
+					onActivate={() => {}}
+					onRevealing={setRevealing}
+				/>
+				<Button
+					type="button"
+					variant="ghost"
+					className="cut-import"
+					disabled={busy || revealing}
+					onPress={() => void run(onImportFile)}
+				>
+					<span className="cut-import-face">
+						{t("ui.import", "Import")}
+						<DownloadSimple className="size-5" aria-hidden="true" />
+					</span>
+				</Button>
+			</div>
+		</div>
+	);
+}
+
+export function CutRoomLibraryControls({ model }: { model: DashboardModel }) {
+	const { t } = useI18n();
+	const [filters, setFilters] = useState(false);
+	const filtersId = useId();
+	const showFilters = filters || model.selecting;
+	return (
+		<div className="cut-library-controls">
+			<div className="cut-library-tabs" role="group" aria-label={t("ui.library", "Library")}>
+				<Button variant="ghost" aria-pressed={!model.isRaw} onPress={() => model.setSection("projects")}>
+					{t("ui.cutRoom.projects", "Projects")}
+				</Button>
+				<Button variant="ghost" aria-pressed={model.isRaw} onPress={() => model.setSection("raw")}>
+					{t("ui.cutRoom.recordings", "Recordings")}
+				</Button>
+			</div>
+			<div className="cut-library-search-row">
+				<label className="cut-library-search">
+					<MagnifyingGlass className="size-4 shrink-0" aria-hidden="true" />
+					<input
+						type="search"
+						value={model.query}
+						onChange={(event) => model.setQuery(event.target.value)}
+						aria-label={t("ui.cutRoom.findInLibrary", "Find in library")}
+						placeholder={t("ui.cutRoom.findInLibrary", "Find in library")}
+					/>
+				</label>
+				<Button
+					variant="ghost"
+					size="icon"
+					className="cut-icon-button"
+					aria-label={t("ui.cutRoom.libraryFilters", "Library filters")}
+					aria-controls={filtersId}
+					aria-expanded={showFilters}
+					onPress={() => {
+						if (showFilters && model.selecting) {
+							model.setSelecting(false);
+							model.setSelected([]);
+						}
+						setFilters(!showFilters);
+					}}
+				>
+					<FunnelSimple className="size-5" aria-hidden="true" />
+				</Button>
+			</div>
+			<div id={filtersId} className="cut-library-filters" hidden={!showFilters}>
+				{showFilters && <DashboardFilters {...model} onCleanup={() => model.setCleanupOpen(true)} />}
+			</div>
+		</div>
+	);
+}
