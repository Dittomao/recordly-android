@@ -0,0 +1,93 @@
+/*
+ * Shared Home/recorder control. Based on vinodjangid07's MIT-licensed
+ * https://uiverse.io/vinodjangid07/smart-emu-83.
+ * Full license is retained in video-editor/layout/CutRoom.css.
+ */
+.cut-record {
+	position: relative;
+	display: inline-block;
+	flex: 0 0 148px;
+	width: 148px;
+	height: 50px;
+	padding: 0;
+	border: 0;
+	border-radius: 50px;
+	corner-shape: round;
+	background: transparent;
+	color: var(--cut-ink, #f4f4f4);
+	font: 650 13px/1.15 "DM Sans", sans-serif;
+	text-align: start;
+	transform: none;
+	touch-action: manipulation;
+	cursor: pointer;
+	-webkit-tap-highlight-color: transparent;
+}
+.cut-record-face {
+	position: absolute;
+	inset-block: 0;
+	inset-inline-start: 0;
+	display: grid;
+	place-items: center;
+	width: 50px;
+	overflow: hidden;
+	border-radius: 50%;
+	corner-shape: round;
+	outline: 2px solid #7f1927;
+	outline-offset: -2px;
+	background: var(--cut-record-color, #d1293b);
+	color: white;
+	pointer-events: none;
+}
+.cut-record-glyph { width: 12px; height: auto; }
+.cut-record-reveal {
+	position: absolute;
+	top: 10px;
+	inset-inline: 0;
+	text-align: center;
+	font-size: 13px;
+	line-height: 18px;
+	transform: translateY(-20px) scale(.65);
+	opacity: 0;
+}
+.cut-record-caption {
+	position: absolute;
+	top: 50%;
+	inset-inline: 57px 0;
+	transform: translateY(-50%);
+	font-size: 12px;
+	line-height: 1.15;
+	text-align: start;
+	white-space: normal;
+}
+.cut-record:not(:disabled):is(:focus-visible, :active, [data-revealing]) {
+	--cut-record-reveal: 1;
+	--cut-record-color: #ff4545;
+}
+.cut-record:focus-visible { outline: 2px solid var(--cut-accent, #a4d5de); outline-offset: 4px; }
+.cut-record:disabled { cursor: default; opacity: .6; }
+@media (hover: hover) and (pointer: fine) {
+	.cut-record:not(:disabled):hover { --cut-record-reveal: 1; --cut-record-color: #ff4545; }
+}
+@media (prefers-reduced-motion: no-preference) {
+	/* Absolute face: width changes never reflow its neighbours. */
+	.cut-record-face {
+		width: calc(50px + var(--cut-record-reveal, 0) * 90px);
+		border-radius: 25px;
+		transition: width 300ms cubic-bezier(.16, 1, .3, 1), background-color 180ms ease;
+	}
+	.cut-record-glyph {
+		transform: translateY(calc(var(--cut-record-reveal, 0) * 60%))
+			scale(calc(1 + var(--cut-record-reveal, 0) * 3.1667));
+		transition: transform 300ms cubic-bezier(.16, 1, .3, 1);
+	}
+	.cut-record-reveal {
+		transform: translateY(calc(-20px + var(--cut-record-reveal, 0) * 20px))
+			scale(calc(.65 + var(--cut-record-reveal, 0) * .35));
+		opacity: var(--cut-record-reveal, 0);
+		transition: transform 300ms cubic-bezier(.16, 1, .3, 1), opacity 200ms ease;
+	}
+	.cut-record-caption { opacity: calc(1 - var(--cut-record-reveal, 0)); transition: opacity 140ms ease; }
+}
+@media (prefers-reduced-motion: reduce) {
+	.cut-record-face { transition: background-color 120ms ease; }
+}
diff --git a/src/components/ui/CutRoomRecordButton.tsx b/src/components/ui/CutRoomRecordButton.tsx
new file mode 100644
index 0000000..75cf7a8
--- /dev/null
+++ b/src/components/ui/CutRoomRecordButton.tsx
@@ -0,0 +1,81 @@
+import { useEffect, useRef, useState } from "react";
+import "./CutRoomRecordButton.css";
+
+/** One record control for Home and the floating recorder. Touch, mouse and keys
+ * all get the same reveal before activation; an ordinary click is never lost. */
+export function CutRoomRecordButton({
+	label,
+	disabled = false,
+	onActivate,
+	onReveal,
+	onRevealing,
+}: {
+	label: string;
+	disabled?: boolean;
+	onActivate: () => void;
+	/** Starts the surface while the button is still revealing. */
+	onReveal?: () => void;
+	onRevealing?: (revealing: boolean) => void;
+}) {
+	const [revealing, setRevealing] = useState(false);
+	const timer = useRef<number | undefined>(undefined);
+	const pressedAt = useRef(0);
+	// A pointerdown and the following click can arrive before React flushes
+	// `revealing`. This ref makes the early surface start happen exactly once.
+	const revealFired = useRef(false);
+	const reveal = () => {
+		if (disabled || timer.current !== undefined || revealFired.current) return;
+		revealFired.current = true;
+		pressedAt.current = performance.now();
+		setRevealing(true);
+		onRevealing?.(true);
+		onReveal?.();
+	};
+	const reset = () => {
+		revealFired.current = false;
+		setRevealing(false);
+		onRevealing?.(false);
+	};
+	useEffect(() => () => window.clearTimeout(timer.current), []);
+
+	return (
+		<button
+			type="button"
+			className="cut-record"
+			aria-label={label}
+			disabled={disabled}
+			data-revealing={revealing || undefined}
+			onPointerDown={reveal}
+			onPointerCancel={reset}
+			onPointerLeave={(event) => {
+				// A touch release also emits pointerleave. Cancelling there races
+				// the click and would start the surface twice; only a mouse drag
+				// away actually cancels the press.
+				if (event.pointerType === "mouse" && timer.current === undefined) reset();
+			}}
+			onKeyDown={(event) => {
+				if (!event.repeat && (event.key === "Enter" || event.key === " ")) reveal();
+			}}
+			onClick={() => {
+				if (timer.current !== undefined || disabled) return;
+				if (!revealing) reveal();
+				const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
+				const remaining = reduced ? 0 : Math.max(0, 320 - (performance.now() - pressedAt.current));
+				timer.current = window.setTimeout(() => {
+					timer.current = undefined;
+					reset();
+					onActivate();
+				}, remaining);
+			}}
+		>
+			<span className="cut-record-face" aria-hidden="true">
+				<svg className="cut-record-glyph" width="12" height="14" viewBox="0 0 24 27.4">
+					<circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" strokeWidth="2" />
+					<circle cx="12" cy="12" r="4.5" fill="currentColor" />
+				</svg>
+				<span className="cut-record-reveal">{label}</span>
+			</span>
+			<span className="cut-record-caption" aria-hidden="true">{label}</span>
+		</button>
+	);
+}
