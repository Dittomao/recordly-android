@@ -0,0 +1,814 @@
+/* Android workbench chrome. The preview canvas and project look are not themed here. */
+.cut-room {
+	--cut-ground: #e7eef0;
+	--cut-sheet: #fff;
+	--cut-inset: #f0f5f5;
+	--cut-rule: #d5e0e2;
+	--cut-ink: #152429;
+	--cut-muted: #4b6269;
+	--cut-accent: #165d6b;
+	--cut-selection: #d7ebec;
+	--cut-stage: #17262c;
+	--cut-primary: #163940;
+	--cut-primary-ink: #fff;
+	--background: var(--cut-ground);
+	--foreground: var(--cut-ink);
+	--surface: var(--cut-sheet);
+	--surface-secondary: var(--cut-inset);
+	--separator: var(--cut-rule);
+	--muted: var(--cut-muted);
+	background: var(--cut-ground);
+	color: var(--cut-ink);
+}
+
+.dark .cut-room {
+	--cut-ground: #182327;
+	--cut-sheet: #222f34;
+	--cut-inset: #2b3b41;
+	--cut-rule: #40545b;
+	--cut-ink: #ebf3f4;
+	--cut-muted: #b2c7cc;
+	--cut-accent: #9ad4dd;
+	--cut-selection: #30545e;
+	--cut-stage: #101a1e;
+	--cut-primary: #b2dce1;
+	--cut-primary-ink: #112c32;
+}
+
+.cut-room .cut-icon-button {
+	width: 44px;
+	min-width: 44px;
+	height: 44px;
+	padding: 0;
+	color: var(--cut-ink);
+}
+
+.cut-room :is(button, input):focus-visible {
+	outline: 2px solid var(--cut-accent);
+	outline-offset: 2px;
+}
+
+.cut-room :is(.cut-home-header, .editor-header) {
+	background: var(--cut-ground);
+	border: 0;
+	column-gap: 6px;
+}
+
+.cut-brand, .cut-header-actions {
+	display: flex;
+	align-items: center;
+	gap: 6px;
+	min-width: 0;
+}
+
+.cut-brand { font-size: 22px; font-weight: 800; letter-spacing: -.045em; }
+.cut-brand > :first-child { color: var(--cut-accent); }
+.cut-header-actions { gap: 0; justify-content: flex-end; }
+.cut-dashboard .cut-dashboard-body { flex-direction: column; }
+.cut-dashboard .cut-library-sheet {
+	margin: 0 10px 8px;
+	border: 1px solid var(--cut-rule);
+	border-radius: 15px;
+	box-shadow: none;
+}
+.cut-home-skeleton-sheet {
+	display: flex;
+	flex: 1;
+	flex-direction: column;
+	gap: 18px;
+	padding: 18px 12px;
+	background: var(--cut-sheet);
+}
+.cut-home-loading .skeleton { background: var(--cut-inset); }
+.cut-home-skeleton-record { width: 50px; height: 50px; margin-inline-end: 98px; border-radius: 50%; }
+.cut-home-skeleton-import { flex: 1 0 104px; height: 50px; border-radius: 10px; }
+
+.cut-library-intro { padding: 9px 20px 16px; }
+.cut-library-intro h1 {
+	margin: 0;
+	font-size: clamp(24px, 7vw, 28px);
+	line-height: 1.12;
+	font-weight: 800;
+	letter-spacing: -.035em;
+	overflow-wrap: anywhere;
+}
+.cut-library-intro p { margin: 6px 0 0; color: var(--cut-muted); font-size: 14px; }
+.cut-home-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 14px; }
+
