diff --git a/src/components/launch/RecorderSetup.css b/src/components/launch/RecorderSetup.css
new file mode 100644
index 0000000..a51955c
--- /dev/null
+++ b/src/components/launch/RecorderSetup.css
@@ -0,0 +1,202 @@
+@font-face {
+	font-family: "DM Sans";
+	src: url("../../assets/fonts/dm-sans/DMSans-Variable.ttf") format("truetype");
+	font-style: normal;
+	font-weight: 100 1000;
+	font-display: swap;
+}
+:root { color-scheme: dark; font: 16px "DM Sans", sans-serif; color: #f4f4f4; }
+*, *::before, *::after { box-sizing: border-box; }
+html, body, #root { margin: 0; background: transparent; overflow: hidden; }
+body { -webkit-tap-highlight-color: transparent; }
+#boot {
+	position: absolute;
+	z-index: 2;
+	top: 12px;
+	left: 50%;
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	height: 40px;
+	/* Same content box as Sileo's header: 8px left, 18px right. */
+	padding: 0 18px 0 8px;
+	border-radius: 16px;
+	background: #181818;
+	color: #d7e8ed;
+	font: 500 0.825rem/1rem "DM Sans", sans-serif;
+	white-space: nowrap;
+	pointer-events: none;
+	transform-origin: center top;
+	/* box-shadow, not filter: a filter re-rasterizes the text during the pop. */
+	box-shadow: 0 6px 9px #00000020;
+	animation: boot-in 500ms both;
+}
+@keyframes boot-in {
+	0% { opacity: 0; transform: translateX(-50%) translateY(-7px) scale(.9); }
+	58% { opacity: 1; transform: translateX(-50%) translateY(1px) scale(1.035); }
+	82% { transform: translateX(-50%) translateY(-.5px) scale(.997); }
+	100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
+}
+.boot-badge {
+	display: grid;
+	place-items: center;
+	width: 24px;
+	height: 24px;
+	border-radius: 50%;
+	background: #253a41;
+}
+.boot-dot { width: 7px; height: 7px; border-radius: 50%; background: #a4d5de; }
+button { font: inherit; cursor: pointer; }
+button:focus-visible { outline: 2px solid #a4d5de; outline-offset: 3px; }
+button:disabled { cursor: default; }
+::selection { background: #30545e; color: #fff; }
+.recorder-stage[data-sileo-viewport] {
+	position: relative;
+	inset: auto;
+	left: auto;
+	transform: none;
+	display: flex;
+	align-items: center;
+	width: 100%;
+	max-width: none;
+	padding: 12px;
+	/* No filter on the stage: its HTML text would be re-rasterized on hover
+	   and while the window resizes, which reads as the word shaking. The
+	   shadow belongs to the SVG shape only. */
+	user-select: none;
+	-webkit-user-select: none;
+}
+.recorder-stage [data-sileo-canvas] {
+	filter: drop-shadow(0 6px 9px #00000020);
+}
+/* Sileo promotes the toast on hover (will-change), which can nudge the
+   composited text by a subpixel. The recorder does not need that hint. */
+@media (prefers-reduced-motion: no-preference) {
+	.recorder-stage [data-sileo-toast][data-ready="true"]:hover,
+	.recorder-stage [data-sileo-toast][data-ready="true"][data-exiting="true"] {
+		will-change: auto !important;
+	}
+}
+/* One entrance only. The boot pill performs the top-anchored Dynamic Island
+   pop; the real Sileo stays invisible and inert until that entrance ends. */
+.recorder-stage:not([data-booted]) [data-sileo-toast] {
+	opacity: 0 !important;
+	transform: none !important;
+	transition: none !important;
+	/* The boot pill is pointer-transparent, so a tap during the pop lands on
+	   the real (still invisible) header and opens the body immediately. */
+	pointer-events: auto;
+}
+.recorder-stage[data-booted] [data-sileo-toast] {
+	opacity: 1 !important;
+	transform: none !important;
+	transform-origin: center top;
+	transition: none !important;
+	pointer-events: auto;
+	touch-action: manipulation;
+}
+.recorder-stage [data-sileo-toast][data-exiting="true"] {
+	opacity: 0 !important;
+	transform: translateY(-7px) scale(.9) !important;
+	pointer-events: none;
+	transition:
+		opacity 240ms cubic-bezier(0.22, 1, 0.36, 1),
+		transform 240ms cubic-bezier(0.22, 1, 0.36, 1) !important;
+}
+/* Sileo hides unopened content with content-visibility, which makes its height
+   unmeasurable before the first expand. Keep the content in layout (opacity 0,
+   inert) and clip it to the animated body height so controls never float over
+   the app before the dark surface arrives behind them. */
+.recorder-stage [data-sileo-content] {
+	content-visibility: visible !important;
+	overflow: hidden;
+	border-radius: 0 0 16px 16px;
+}
+.recorder-stage [data-sileo-description] { content-visibility: visible !important; }
+/* Sileo fades the body fill in while it grows. On a floating overlay that
+   lets the bright app underneath show through the card (red Record, Import,
+   title), which reads as the card/word wobbling. The body must be opaque for
+   every pixel of the expansion; only its height animates. */
+.recorder-stage [data-sileo-body] { opacity: 1 !important; }
+/* A toast can fade its body in after the shape lands; a recorder cannot show an
+   empty black card while the controls arrive, nor vanish them abruptly before
+   the card finishes closing. */
+.recorder-stage [data-sileo-toast][data-ready="true"] [data-sileo-content] {
+	transition: opacity 200ms ease 0ms !important;
+}
+.recorder-stage [data-sileo-toast][data-ready="true"] [data-sileo-content][data-visible="true"] {
+	transition: opacity 160ms ease 30ms !important;
+}
+.recorder-stage [data-sileo-header] {
+	padding: 8px;
+	/* Sileo scales the header to .9 while open, shrinking a 40px pill to a
+	   36px control. Keep the pill at its full 40px for touch. The body and
+	   the gooey silhouette still move on the upstream spring. */
+	transform: none !important;
+	transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
+}
+.recorder-stage [data-sileo-header-stack] {
+	/* The Sileo header is 40px with 8px padding. Extend the actual button
+	   through that padding so the whole visible pill folds it, not a 24px
+	   strip in the middle. The inner content stays at the same x/y. */
+	height: calc(100% + 16px);
+	margin-block: -8px;
+	margin-inline: -8px;
+	padding-inline: 8px;
+	border: 0;
+	background: transparent;
+	color: #d7e8ed;
+	-webkit-tap-highlight-color: transparent;
+}
+.recorder-stage [data-sileo-title] {
+	text-transform: none;
+	font-size: 13px;
+	font-weight: 600;
+	--sileo-tone: #d7e8ed;
+}
+.recorder-stage [data-sileo-badge] {
+	--sileo-tone-bg: #253a41;
+	--sileo-tone: #a4d5de;
+}
+.recorder-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
+.recorder-stage [data-sileo-description] { padding: 12px 16px 16px; color: #f4f4f4; overflow: hidden; }
+.recorder-options { display: flex; align-items: center; gap: 10px; }
+.recorder-mic {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	flex: 1;
+	min-width: 0;
+	height: 46px;
+	border: 0;
+	border-radius: 12px;
+	padding: 0 10px;
+	background: #2a2a2a;
+	color: #f4f4f4;
+	font-size: 13px;
+	transition: background-color 150ms ease, transform 150ms ease;
+}
+.recorder-mic:active { transform: scale(.97); }
+.recorder-option-state { color: #b9c2c5; }
+.recorder-mic svg, .recorder-screen svg { width: 18px; height: 18px; flex: none; }
+.recorder-switch { width: 28px; height: 17px; padding: 2px; margin-left: auto; border-radius: 12px; background: #5b6163; transition: background-color 150ms ease; }
+.recorder-switch > span { display: block; width: 13px; height: 13px; border-radius: 50%; background: #f4f4f4; transition: transform 180ms cubic-bezier(.16, 1, .3, 1); }
+[aria-pressed="true"] .recorder-switch { background: #396b76; }
+[aria-pressed="true"] .recorder-switch > span { transform: translateX(11px); }
+.recorder-screen { display: flex; align-items: center; justify-content: center; gap: 7px; width: 98px; height: 46px; color: #b9c2c5; font-size: 13px; }
+.recorder-actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 14px; }
+.recorder-close { height: 44px; padding: 0 10px; border: 0; border-radius: 12px; background: transparent; color: #c3c9cb; font-size: 13px; transition: background-color 150ms ease; }
+.recorder-close:is(:active, :hover) { background: #2a2a2a; }
+.recorder-note { margin: 12px 0 0; color: #b9c2c5; font-size: 12px; line-height: 18px; }
+.recorder-note[role="alert"] { color: #ffb9be; }
+@media (prefers-reduced-motion: reduce) {
+	.recorder-stage *, .recorder-stage *::before, .recorder-stage *::after {
+		transition-duration: 100ms !important;
+		transition-delay: 0ms !important;
+		animation-duration: .01ms !important;
+		animation-iteration-count: 1 !important;
+	}
+	.recorder-stage [data-sileo-toast][data-exiting="true"] { transform: none !important; }
+	#boot { animation-duration: .01ms; animation-iteration-count: 1; }
+	.recorder-mic:active { transform: none; }
+}
diff --git a/src/components/launch/RecorderSetup.tsx b/src/components/launch/RecorderSetup.tsx
new file mode 100644
index 0000000..d6f5551
--- /dev/null
+++ b/src/components/launch/RecorderSetup.tsx
@@ -0,0 +1,270 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { useReducedMotion } from "motion/react";
+import { CutRoomRecordButton } from "../ui/CutRoomRecordButton";
+import { Sileo } from "./sileo/sileo";
+import "./RecorderSetup.css";
+
+interface RecorderNative {
+	ready(): void;
+	prepare?(expandedHeight: number): void;
+	resize(height: number, pillWidth: number, expanded: boolean): void;
+	microphone?(): boolean;
+	setMicrophone?(enabled: boolean): void;
+	start(microphone: boolean): void;
+	close(): void;
+}
+
+declare global {
+	interface Window {
+		TapswoopRecorder?: RecorderNative;
+	}
+}
+
+const DEFAULT_IDLE_MS = 20_000;
+const DEFAULT_COMPACT_IDLE_MS = 10_000;
+
+/** The 20 s fold and 10 s compact dismiss are production behaviour; query overrides let the UI verifier run fast. */
+function queryMs(name: string, fallback: number): number {
+	const value = Number(new URLSearchParams(window.location.search).get(name));
+	return Number.isFinite(value) && value >= 400 ? value : fallback;
+}
+
+function MicIcon({ on }: { on: boolean }) {
+	return <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" aria-hidden="true">
+		<rect x="9" y="3" width="6" height="12" rx="3" />
+		<path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8" />
+		{!on && <path d="m3 3 18 18" />}
+	</svg>;
+}
+
+function RecorderSetup() {
+	const [expanded, setExpanded] = useState(false);
+	const [phase, setPhase] = useState<"arriving" | "setup" | "starting" | "closing">("arriving");
+	const [micOn, setMicOn] = useState(() => window.TapswoopRecorder?.microphone?.() ?? true);
+	const [width, setWidth] = useState(() => Math.min(350, window.innerWidth - 24));
+	const [error, setError] = useState("");
+	const [activity, setActivity] = useState(0);
+	const reducedMotion = useReducedMotion();
+	const idleMs = useRef(queryMs("idleMs", DEFAULT_IDLE_MS)).current;
+	const compactIdleMs = useRef(queryMs("compactIdleMs", DEFAULT_COMPACT_IDLE_MS)).current;
+	const stage = useRef<HTMLDivElement>(null);
+	const actionTimer = useRef<number | undefined>(undefined);
+	const closingExpandedRef = useRef(false);
+	const busy = phase === "starting" || phase === "closing";
+
+	const openSetup = () => {
+		if (expanded || busy || phase === "arriving") return;
+		setExpanded(true);
+	};
+
+	const noteActivity = () => setActivity((value) => value + 1);
+
+	useEffect(() => {
+		// Arrival leaves the setup as a compact Dynamic Island-style pill. Only
+		// a tap on that pill opens the body.
+		const arrive = () => {
+			setPhase("setup");
+			setExpanded(false);
+		};
+		const open = () => {
+			setExpanded((was) => (was || busy || phase === "arriving" ? was : true));
+		};
+		const outside = () => setExpanded(false);
+		const ping = () => { if (!busy && !expanded) noteActivity(); };
+		const back = () => {
+			if (!busy) {
+				closingExpandedRef.current = expanded;
+				setPhase("closing");
+				setExpanded(false);
+			}
+		};
+		const resize = () => setWidth(Math.min(350, window.innerWidth - 24));
+		window.addEventListener("tapswoop-recorder-arrived", arrive);
+		window.addEventListener("tapswoop-recorder-open", open);
+		window.addEventListener("tapswoop-recorder-outside", outside);
+		window.addEventListener("tapswoop-recorder-ping", ping);
+		window.addEventListener("tapswoop-recorder-back", back);
+		window.addEventListener("resize", resize);
+		return () => {
+			window.removeEventListener("tapswoop-recorder-arrived", arrive);
+			window.removeEventListener("tapswoop-recorder-open", open);
+			window.removeEventListener("tapswoop-recorder-outside", outside);
+			window.removeEventListener("tapswoop-recorder-ping", ping);
+			window.removeEventListener("tapswoop-recorder-back", back);
+			window.removeEventListener("resize", resize);
+		};
+	}, [busy, phase, expanded]);
+
+	useEffect(() => {
+		let cancelled = false;
+		let first = 0;
+		let second = 0;
+		void document.fonts.ready.then(() => {
+			first = requestAnimationFrame(() => {
+				second = requestAnimationFrame(() => {
+					if (cancelled) return;
+					const boot = document.getElementById("boot");
+					const native = window.TapswoopRecorder;
+					const description = stage.current?.querySelector<HTMLElement>("[data-sileo-description]");
+					if (native) {
+						if (description) native.prepare?.(description.scrollHeight + 76);
+						native.ready();
+					} else {
+						setPhase("setup");
+						setExpanded(true);
+					}
+					// The boot pill owns the single Dynamic-Island entrance. Keep
+					// the real Sileo hidden underneath until that entrance ends,
+					// then swap them in the same frame at identical geometry.
+					let revealed = false;
+					const reveal = () => {
+						if (revealed || cancelled) return;
+						revealed = true;
+						stage.current?.setAttribute("data-booted", "true");
+						boot?.remove();
+					};
+					if (boot) {
+						const animation = boot.getAnimations()[0];
+						const fallback = window.setTimeout(reveal, 900);
+						if (animation && animation.playState !== "finished") {
+							animation.finished
+								.then(() => { window.clearTimeout(fallback); reveal(); })
+								.catch(() => { window.clearTimeout(fallback); reveal(); });
+						} else {
+							window.clearTimeout(fallback);
+							reveal();
+						}
+					} else {
+						reveal();
+					}
+				});
+			});
+		});
+		return () => { cancelled = true; cancelAnimationFrame(first); cancelAnimationFrame(second); };
+	}, []);
+
+	// The native window is exactly the surface. Folded, it shrinks to the pill;
+	// open, it grows to the measured body. Wait out the Sileo exit before
+	// shrinking so its liquid silhouette is never clipped.
+	useLayoutEffect(() => {
+		const root = stage.current;
+		const description = root?.querySelector<HTMLElement>("[data-sileo-description]");
+		const toast = root?.querySelector<HTMLElement>("[data-sileo-toast]");
+		if (!description || !toast) return;
+		let timer = 0;
+		const report = () => {
+			const pill = Number.parseFloat(toast.style.getPropertyValue("--_pw")) || 190;
+			const height = expanded ? description.scrollHeight + 76 : 64;
+			window.TapswoopRecorder?.resize(height, pill, expanded);
+		};
+		if (expanded) report();
+		else timer = window.setTimeout(report, reducedMotion ? 0 : 720);
+		const observer = new ResizeObserver(() => { if (expanded) report(); });
+		observer.observe(description);
+		return () => { window.clearTimeout(timer); observer.disconnect(); };
+	}, [expanded, width, error, reducedMotion]);
+
+	// A Dynamic Island folds itself after 20 s without expanded interaction, and
+	// dismisses itself cleanly after 10 s if the compact pill is never opened.
+	useEffect(() => {
+		if (phase !== "setup") return;
+		if (expanded) {
+			const timer = window.setTimeout(() => setExpanded(false), idleMs);
+			return () => window.clearTimeout(timer);
+		}
+		const timer = window.setTimeout(() => {
+			closingExpandedRef.current = false;
+			setPhase("closing");
+		}, compactIdleMs);
+		return () => window.clearTimeout(timer);
+	}, [expanded, phase, activity, idleMs, compactIdleMs]);
+
+	useEffect(() => {
+		if (phase !== "starting" && phase !== "closing") return;
+		const delay = reducedMotion ? 80 : (phase === "closing" && !closingExpandedRef.current ? 280 : 680);
+		actionTimer.current = window.setTimeout(() => {
+			if (phase === "closing") window.TapswoopRecorder?.close();
+			else if (window.TapswoopRecorder) window.TapswoopRecorder.start(micOn);
+			else {
+				setError("Recording is available in the Android app.");
+				setPhase("setup");
+				setExpanded(true);
+			}
+		}, delay);
+		return () => window.clearTimeout(actionTimer.current);
+	}, [phase, micOn, reducedMotion]);
+
+	useEffect(() => {
+		const keydown = (event: KeyboardEvent) => {
+			if (event.key === "Escape" && !busy) {
+				closingExpandedRef.current = expanded;
+				setPhase("closing");
+				setExpanded(false);
+			}
+		};
+		window.addEventListener("keydown", keydown);
+		return () => window.removeEventListener("keydown", keydown);
+	}, [busy, expanded]);
+
+	return (
+		<div ref={stage} className="recorder-stage" data-phase={phase}
+			data-sileo-viewport data-position="top-center" data-theme="light"
+			onPointerDownCapture={noteActivity} onKeyDownCapture={noteActivity}>
+			<Sileo
+				id="tapswoop-recorder"
+				state="info"
+				title={phase === "starting" ? "Starting…" : "Ready to record"}
+				icon={<span className="recorder-dot" />}
+				position="center"
+				expand="bottom"
+				fill="#181818"
+				roundness={16}
+				width={width}
+				bounce={0}
+				expanded={expanded}
+				exiting={phase === "closing"}
+				onExpandedChange={(open) => {
+					if (open) openSetup();
+					else if (!busy) setExpanded(false);
+				}}
+				description={
+					<div className="recorder-controls">
+						<div className="recorder-options">
+							<button className="recorder-mic" type="button" aria-pressed={micOn}
+								aria-label="Microphone" disabled={busy} onClick={() => {
+									const next = !micOn;
+									setMicOn(next);
+									window.TapswoopRecorder?.setMicrophone?.(next);
+								}}>
+								<MicIcon on={micOn} />
+								<span>Mic <span className="recorder-option-state">{micOn ? "on" : "off"}</span></span>
+								<span className="recorder-switch" aria-hidden="true"><span /></span>
+							</button>
+							<div className="recorder-screen">
+								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" aria-hidden="true">
+									<rect x="7" y="2" width="10" height="20" rx="3" /><path d="M10 18h4" />
+								</svg>
+								<span>Screen</span>
+							</div>
+						</div>
+						<div className="recorder-actions">
+							<CutRoomRecordButton label="New recording" disabled={busy} onActivate={() => {
+								setError("");
+								setExpanded(false);
+								setPhase("starting");
+							}} />
+							<button type="button" className="recorder-close" disabled={busy}
+								onClick={() => { closingExpandedRef.current = expanded; setExpanded(false); setPhase("closing"); }}>Cancel</button>
+						</div>
+						<p className="recorder-note" role={error ? "alert" : undefined}>
+							{error || "Android will ask to share your screen."}
+						</p>
+					</div>
+				}
+			/>
+		</div>
+	);
+}
+
+createRoot(document.getElementById("root")!).render(<RecorderSetup />);
