+++ b/src/components/video-editor/touchZoomPolicy.ts
@@ -0,0 +1,77 @@
+import { ZOOM_DEPTH_SCALES, type ZoomDepth, type ZoomFocus } from "./types";
+
+/**
+ * Auto-zoom parameters for touch hosts.
+ *
+ * Android telemetry is tap-only: an accessibility click is the interaction, and
+ * there is no pointer track between taps. The desktop clustering merges clicks
+ * up to 2.5 s apart into one zoom region, which means a demo that taps every
+ * second or two gets one long zoom instead of a zoom in/out per tap. Touch uses
+ * a much shorter merge gap so each tap owns a region, while still merging rapid
+ * repeated taps (typing, double taps) into one.
+ *
+ * Desktop blocks are centred on the click: the zoom reaches full scale about a
+ * second before the click, while the pointer travels to the target. Touch has
+ * no pointer, so the camera would zoom with no visible cause and the tap
+ * indicator would arrive mid-hold. A short lead starts the zoom with the tap
+ * instead.
+ *
+ * The trailing reserve keeps the last region's zoom-out inside the recording
+ * instead of letting it be cut off by the final frame.
+ */
+export const TOUCH_CLICK_MERGE_GAP_MS = 800;
+export const TOUCH_CLICK_PAD_MS = 450;
+export const TOUCH_TRAILING_RESERVE_MS = 360;
+export const TOUCH_ZOOM_LEAD_MS = 200;
+
+/**
+ * True inside the Android WebView. `android.js` installs `__recordlyHost`
+ * before the React bundle; desktop Electron and the Chrome dev server do not.
+ */
+export function isTouchHost(): boolean {
+	return typeof window !== "undefined" && "__recordlyHost" in window;
+}
+
+export type TouchZoomParams = {
+	mergeGapMs?: number;
+	padMs?: number;
+	trailingReserveMs?: number;
+	leadMs?: number;
+};
+
+export function touchZoomParams(): TouchZoomParams {
+	if (!isTouchHost()) return {};
+	return {
+		mergeGapMs: TOUCH_CLICK_MERGE_GAP_MS,
+		padMs: TOUCH_CLICK_PAD_MS,
+		trailingReserveMs: TOUCH_TRAILING_RESERVE_MS,
+		leadMs: TOUCH_ZOOM_LEAD_MS,
+	};
+}
+
+/**
+ * Pick the shallowest depth that can still centre the tap.
+ *
+ * A zoom places the tap at the middle of the crop, so the reachable focus range
+ * for a depth is `[0.5/scale, 1 - 0.5/scale]`: 1.25× can only centre the middle
+ * 20% of the screen, 1.8× reaches the middle 44%. A touch target near an edge
+ * (a bottom navigation row, a side button) was previously clamped back toward
+ * the centre and read as "the zoom missed the tap". Choosing the shallowest
+ * depth whose clamp keeps the target within a tenth of the frame keeps central
+ * taps gentle while letting edge taps land.
+ *
+ * The 1.8× cap keeps an edge tap from becoming a disorienting close-up.
+ */
+export function touchZoomDepth(focus: ZoomFocus): ZoomDepth {
+	const cx = Math.max(0, Math.min(focus.cx, 1));
+	const cy = Math.max(0, Math.min(focus.cy, 1));
+	for (const depth of [1, 2, 3] as const) {
+		const margin = 1 / (2 * ZOOM_DEPTH_SCALES[depth]);
+		const error = Math.max(
+			Math.abs(Math.max(margin, Math.min(cx, 1 - margin)) - cx),
+			Math.abs(Math.max(margin, Math.min(cy, 1 - margin)) - cy),
+		);
+		if (error <= 0.1 + 1e-6) return depth;
+	}
+	return 3;
+}
