+function hasSeenTour() {
+	const value = loadAppSetting<boolean | string>(TAPSWOOP_ONBOARDING_SEEN_KEY);
+	return value === true || value === "true";
+}
+
+export function TapSwoopOnboarding() {
+	const { t } = useI18n();
