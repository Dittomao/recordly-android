--- /dev/null
+++ b/vite.android.config.mjs
@@ -0,0 +1,24 @@
+/**
+ * Android renderer build. Upstream's production recorder requires a cloud
+ * session, which this sideloaded offline app cannot obtain. Keep upstream's
+ * UI build and its development recorder gate until that check is made local.
+ */
+import { fileURLToPath } from "node:url";
+
+// The Vite module runner leaves CommonJS's __dirname undefined in the
+// upstream config. Give it the directory esbuild's default config loader
+// would have supplied before importing that config.
+globalThis.__dirname = fileURLToPath(new URL(".", import.meta.url));
+const { default: upstream } = await import("./vite.config.ts");
+
+export default async function androidConfig(env) {
+	const config = typeof upstream === "function" ? await upstream(env) : upstream;
+	return {
+		...config,
+		define: {
+			...config.define,
+			"import.meta.env.DEV": "true",
+			"import.meta.env.PROD": "false",
+		},
+	};
+}
