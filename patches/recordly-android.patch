+	TOUCH_ZOOM_LEAD_MS,
+	touchZoomDepth,
+} from "./touchZoomPolicy";
+
+const click = (timeMs: number, cx = 0.5, cy = 0.5): CursorTelemetryPoint => ({
+	timeMs,
+	cx,
+	cy,
+	interactionType: "click",
+	mouseButton: 1,
+});
+
+const release = (timeMs: number, cx = 0.5, cy = 0.5): CursorTelemetryPoint => ({
+	timeMs,
+	cx,
+	cy,
+	interactionType: "mouseup",
+	mouseButton: 1,
+});
+
+function suggestions(samples: CursorTelemetryPoint[], totalMs: number, touch = true) {
+	return buildInteractionZoomSuggestions({
+		cursorTelemetry: samples,
+		totalMs,
+		defaultDurationMs: 2000,
+		...(touch
+			? {
+					mergeGapMs: TOUCH_CLICK_MERGE_GAP_MS,
+					padMs: TOUCH_CLICK_PAD_MS,
+					trailingReserveMs: TOUCH_TRAILING_RESERVE_MS,
+					leadMs: TOUCH_ZOOM_LEAD_MS,
+				}
+			: {}),
+	});
+}
+
+describe("touch auto-zoom policy", () => {
+	it("gives each tap 1.5 s apart its own zoom region", () => {
+		const samples = [
+			click(3000),
+			release(3080),
+			click(4500),
+			release(4580),
+			click(6000),
+			release(6080),
+		];
+		const result = suggestions(samples, 10_000);
+		expect(result.suggestions).toHaveLength(3);
+		for (const [index, region] of result.suggestions.entries()) {
+			const tap = [3000, 4500, 6000][index];
+			expect(region.start).toBeLessThanOrEqual(tap);
+			expect(region.end).toBeGreaterThanOrEqual(tap);
+			expect(region.end - region.start).toBeGreaterThanOrEqual(800);
+		}
+	});
+
+	it("starts a touch region with the tap, not a second before it", () => {
+		const samples = [click(3000), release(3080), click(7000), release(7080)];
+		const result = suggestions(samples, 12_000);
+		expect(result.suggestions).toHaveLength(2);
+		for (const [index, region] of result.suggestions.entries()) {
+			const tap = [3000, 7000][index];
+			expect(Math.abs(region.start - (tap - TOUCH_ZOOM_LEAD_MS))).toBeLessThanOrEqual(1);
+			expect(region.end - region.start).toBeGreaterThanOrEqual(1900);
+		}
+	});
+
+	it("keeps the desktop merge gap and centred lead when the host is not touch", () => {
+		const samples = [
+			click(3000),
+			release(3080),
+			click(4500),
+			release(4580),
+			click(6000),
+			release(6080),
+		];
+		expect(suggestions(samples, 10_000, false).suggestions).toHaveLength(1);
+		const isolated = suggestions([click(5000), release(5080)], 10_000, false);
+		expect(isolated.suggestions[0].start).toBe(4000);
+	});
+
+	it("ignores swipe movement with no tap", () => {
+		const samples: CursorTelemetryPoint[] = [
+			{ timeMs: 1000, cx: 0.5, cy: 0.7, interactionType: "move" },
+			{ timeMs: 1300, cx: 0.5, cy: 0.55, interactionType: "move" },
+			{ timeMs: 1600, cx: 0.5, cy: 0.4, interactionType: "move" },
+			{ timeMs: 1900, cx: 0.5, cy: 0.3, interactionType: "move" },
+			click(4000, 0.25, 0.6),
+			release(4080, 0.25, 0.6),
+		];
+		const result = suggestions(samples, 10_000);
+		expect(result.suggestions).toHaveLength(1);
+		expect(result.suggestions[0].focus).toEqual({ cx: 0.25, cy: 0.6 });
+	});
+
+	it("reserves room for the final zoom-out when the tap is not at the edge", () => {
+		const samples = [click(9200), release(9280)];
+		const result = suggestions(samples, 10_000);
+		expect(result.suggestions).toHaveLength(1);
+		expect(result.suggestions[0].end).toBeLessThanOrEqual(10_000 - TOUCH_TRAILING_RESERVE_MS);
+	});
+
+	it("brings edge taps within reach by choosing a deeper zoom", () => {
+		expect(touchZoomDepth({ cx: 0.5, cy: 0.5 })).toBe(1);
+		expect(touchZoomDepth({ cx: 0.5, cy: 0.35 })).toBe(1);
+		expect(touchZoomDepth({ cx: 0.5, cy: 0.267 })).toBe(2);
+		expect(touchZoomDepth({ cx: 0.5, cy: 0.2 })).toBe(3);
+		expect(touchZoomDepth({ cx: 0.9, cy: 0.9 })).toBe(3);
+	});
+
+	it("keeps the rendered focus close to the actual tap", () => {
+		const taps = [
+			{ cx: 0.5, cy: 0.5 },
+			{ cx: 0.5, cy: 0.2 },
+			{ cx: 0.5, cy: 0.9 },
+			{ cx: 0.9, cy: 0.5 },
+		];
+		for (const tap of taps) {
+			const depth = touchZoomDepth(tap);
+			const clamped = clampFocusToScale(tap, ZOOM_DEPTH_SCALES[depth]);
+			const error = Math.max(Math.abs(clamped.cx - tap.cx), Math.abs(clamped.cy - tap.cy));
+			expect(error).toBeLessThanOrEqual(0.19);
+		}
+	});
+});
