@@ -0,0 +1,76 @@
+import type { ZoomDepth, ZoomFocus } from "./types";
+
+/**
+ * Auto-zoom parameters for touch hosts.
+ *
+ * Android telemetry is tap-only: an accessibility click is the interaction, and
+ * there is no pointer track between taps. The desktop clustering merges clicks
+ * up to 2.5 s apart into one zoom region, which means a demo that taps every
+ * second or two gets one long zoom instead of a zoom in/out per tap. Touch uses
+ * a much shorter merge gap, and only repeats in the same area extend a visit.
+ *
+ * Desktop blocks are centred on the click: the zoom reaches full scale about a
+ * second before the click, while the pointer travels to the target. Touch has
+ * no pointer, so the camera would zoom with no visible cause and the tap
+ * indicator would arrive mid-hold. A short lead starts the zoom with the tap
+ * instead.
+ *
+ * The trailing reserve keeps the last region's zoom-out inside the recording
+ * instead of letting it be cut off by the final frame.
+ */
+export const TOUCH_CLICK_MERGE_GAP_MS = 800;
+export const TOUCH_TRAILING_RESERVE_MS = 360;
+export const TOUCH_ZOOM_LEAD_MS = 250;
+export const TOUCH_DEFAULT_DURATION_MS = 1300;
+export const TOUCH_WIDE_BEAT_MS = 100;
+export const TOUCH_MIN_AFTER_TAP_MS = 300;
+const TOUCH_REPEAT_FOCUS_RADIUS = 0.12;
+
+export function isSameTouchFocus(a: ZoomFocus, b: ZoomFocus): boolean {
+	return Math.hypot(a.cx - b.cx, a.cy - b.cy) <= TOUCH_REPEAT_FOCUS_RADIUS;
+}
+
+/**
+ * True inside the Android WebView. `android.js` installs `__recordlyHost`
+ * before the React bundle; desktop Electron and the Chrome dev server do not.
+ */
+export function isTouchHost(): boolean {
+	return typeof window !== "undefined" && "__recordlyHost" in window;
+}
+
+export type TouchZoomParams = {
+	mergeGapMs?: number;
+	touchTiming?: {
+		leadMs: number;
+		defaultDurationMs?: number;
+		wideBeatMs: number;
+		minAfterTapMs: number;
+		trailingReserveMs: number;
+	};
+};
+
+export function touchZoomParams(touch = isTouchHost()): TouchZoomParams {
+	if (!touch) return {};
+	return {
+		mergeGapMs: TOUCH_CLICK_MERGE_GAP_MS,
+		touchTiming: {
+			leadMs: TOUCH_ZOOM_LEAD_MS,
+			defaultDurationMs: TOUCH_DEFAULT_DURATION_MS,
+			wideBeatMs: TOUCH_WIDE_BEAT_MS,
+			minAfterTapMs: TOUCH_MIN_AFTER_TAP_MS,
+			trailingReserveMs: TOUCH_TRAILING_RESERVE_MS,
+		},
+	};
+}
+
+/**
+ * Use a steady 1.5× touch depth across phone captures so adjacent taps never
+ * bounce between shallow 1.25× nudges and tight 1.8× edge crops.
+ *
+ * At 1.5×, `clampFocusToScale` keeps the centre within `[1/3, 2/3]`: edge tabs
+ * and toolbar buttons still land inside the zoomed viewport with their sibling
+ * controls and popup menus visible rather than cutting across narrow portrait UI.
+ */
+export function touchZoomDepth(_focus: ZoomFocus): ZoomDepth {
+	return 2;
+}
