+	.modal__backdrop.cut-motion-overlay { --cut-motion-in: 100ms ease-out; --cut-motion-out: 80ms ease-in; }
+	.cut-motion-panel[data-entering="true"], .cut-motion-panel[data-exiting="true"] { animation: none; }
+}
+.cut-room:is(.cut-settings-sheet, .cut-drawer) {
+	position: relative;
+	display: flex;
+	flex-direction: column;
+	width: min(100%, 560px);
+	max-height: 100%;
+	min-height: 0;
+	gap: 0;
+	padding: 0;
+	overflow: hidden;
+	border: 1px solid var(--cut-rule);
+	border-radius: 14px;
+	background: var(--cut-sheet);
+}
+.cut-room.cut-settings-sheet { height: min(86dvh, 720px); }
+.cut-room.cut-drawer { width: min(84%, 296px); height: 100%; }
+.cut-drawer .dashboard-sidebar {
+	position: static;
+	width: 100%;
+	flex: 1 1 auto;
+	padding: 8px 12px 16px;
+	box-shadow: none;
+	background: var(--cut-sheet);
+}
+.cut-drawer .dashboard-sidebar-close { display: none; }
+.cut-drawer .dashboard-sidebar :is(button, [role="button"]) { min-height: 44px; }
+.cut-panel-header {
+	display: flex;
+	flex: none;
+	flex-direction: row;
+	align-items: center;
+	justify-content: space-between;
+	gap: 12px;
+	min-height: 56px;
+	padding: 6px 8px 6px 16px;
+	border-bottom: 1px solid var(--cut-rule);
+}
+.cut-panel-header [data-slot="modal-heading"] { font-size: 1.125rem; font-weight: 750; }
+.cut-panel-header .cut-panel-close {
+	position: static;
+	width: 44px;
+	height: 44px;
+	flex-shrink: 0;
+	color: var(--cut-ink);
+}
+.cut-room.cut-settings-sheet .app-settings-body { padding: 0 16px; }
+.cut-settings-sheet .dashboard-settings { --settings-section-gap: 14px; }
+.cut-settings-sheet .dashboard-settings-tab-list { scrollbar-width: none; }
+.cut-settings-sheet .dashboard-settings-navigation .tabs__tab {
+	min-height: 44px;
+	padding: 8px 10px;
+}
+.cut-settings-sheet .dashboard-settings-tab-list .tabs__tab[aria-selected="true"] {
+	color: var(--cut-accent);
+	background: var(--cut-selection);
+}
+.cut-settings-sheet .dashboard-settings-tab-panel { padding-inline-end: 2px; }
+.cut-settings-sheet .dashboard-settings .theme-appearance-picker { gap: 8px; }
+.cut-settings-sheet .theme-appearance-content { width: 100%; }
+.cut-theme-choice {
+	position: relative;
+	display: grid;
+	min-height: 50px;
+	width: 100%;
+	place-items: center;
+	border: 1px solid var(--cut-rule);
+	border-radius: 9px;
+	background: var(--cut-inset);
+	color: var(--cut-muted);
+}
+.cut-theme-check { position: absolute; inset-block-start: 5px; inset-inline-end: 5px; opacity: 0; }
+.theme-appearance-option[data-selected] .cut-theme-choice {
+	color: var(--cut-accent);
+	border-color: var(--cut-accent);
+	background: var(--cut-selection);
+}
+.theme-appearance-option[data-selected] .cut-theme-check { opacity: 1; }
+.theme-appearance-option[data-focus-visible] .cut-theme-choice { outline: 2px solid var(--cut-accent); outline-offset: 2px; }
+@media (max-width: 680px) {
+	.cut-settings-sheet .dashboard-settings-navigation {
+		flex: none;
+		padding: 8px 0;
+		border-right: 0;
+		border-bottom: 1px solid var(--cut-rule);
+	}
+	.cut-settings-sheet .dashboard-settings-tab-list {
+		width: 100%;
+		box-sizing: border-box;
+		overflow: auto hidden;
+		overscroll-behavior-inline: contain;
+	}
+	.cut-settings-sheet .dashboard-settings-tab-list .tabs__tab { flex: 0 0 auto; }
+}
+.cut-preview-volume { display: grid; gap: 8px; padding: 12px 16px; }
+.cut-preview-volume input { min-height: 44px; accent-color: var(--cut-accent); }
+.cut-room-toasts { bottom: 126px !important; }
+.cut-library-count { padding-block: 8px; color: var(--cut-muted); font-size: 12px; }
diff --git a/src/components/video-editor/layout/CutRoomEditorTools.tsx b/src/components/video-editor/layout/CutRoomEditorTools.tsx
new file mode 100644
index 0000000..e0d20c0
--- /dev/null
+++ b/src/components/video-editor/layout/CutRoomEditorTools.tsx
@@ -0,0 +1,225 @@
+import { useId, useLayoutEffect, useRef, useState, type ComponentProps, type ReactNode, type RefObject } from "react";
+import { Button } from "@/components/ui/button";
+import { FilmStrip, FrameCorners, MagnifyingGlassPlus, Plus, Scissors, SpeakerHigh, X } from "@/components/ui/icons";
+import { useI18n } from "@/contexts/I18nContext";
+import { formatPlaybackTime } from "../playbackTime";
+import { SettingsPanel } from "../SettingsPanel";
+import type { TimelineEditorHandle } from "../timeline/TimelineEditor";
+import type { EditorEffectSection } from "../types";
+
+type Tool = "trim" | "zoom" | "look" | "audio" | "clips";
+type Props = {
+	duration: number;
+	canSplit: boolean;
+	isCropping: boolean;
+	timelinePanel: ReactNode;
+	timelineRef: RefObject<TimelineEditorHandle | null>;
+	settings: ComponentProps<typeof SettingsPanel>;
+	clearSelection: () => void;
+	clipsOpen: boolean;
+	setClipsOpen: (open: boolean) => void;
+	clips: ReactNode;
+	nextAudioTrack: number;
+	previewVolume: number;
+	setPreviewVolume: (volume: number) => void;
+};
+
+export function CutRoomEditorTools({
+	duration, canSplit, isCropping, timelinePanel, timelineRef, settings, clearSelection, clipsOpen, setClipsOpen,
+	clips, nextAudioTrack, previewVolume, setPreviewVolume,
+}: Props) {
+	const { t } = useI18n();
+	const [tool, setTool] = useState<Tool>("trim");
+	const [inspector, setInspector] = useState<EditorEffectSection | null>(null);
+	const [advanced, setAdvanced] = useState(false);
+	const panelRef = useRef<HTMLElement>(null);
+	const scrollRef = useRef<HTMLDivElement>(null);
+	const railRef = useRef<HTMLElement>(null);
+	const panelId = useId();
+	const selectedTool: Tool | undefined = settings.selectedZoomId ? "zoom"
+		: settings.selectedAudioId ? "audio"
+		: settings.selectedAnnotationId || settings.selectedCaptionId ? "look"
+		: settings.selectedClipId ? "trim"
+		: undefined;
+	const panelTool: Tool | null = clipsOpen ? "clips"
+		: inspector === null ? null
+		: inspector === "clip" ? "trim"
+		: inspector === "zoom" || inspector === "audio" ? inspector
+		: "look";
+	const visiblePanel = isCropping ? null : panelTool;
+	const active = panelTool ?? selectedTool ?? tool;
+	useLayoutEffect(() => {
+		if (visiblePanel) panelRef.current?.focus({ preventScroll: true });
+	}, [visiblePanel]);
+	useLayoutEffect(() => {
+		if (scrollRef.current) scrollRef.current.scrollTop = 0;
+	}, [inspector]);
+	const tools = [
+		{ id: "trim", label: t("ui.cutRoom.trim", "Trim"), icon: Scissors },
+		{ id: "zoom", label: t("ui.cutRoom.zoom", "Zoom"), icon: MagnifyingGlassPlus },
+		{ id: "look", label: t("ui.cutRoom.look", "Look"), icon: FrameCorners },
+		{ id: "audio", label: t("ui.audio", "Audio"), icon: SpeakerHigh },
+		{ id: "clips", label: t("ui.clips", "Clips"), icon: FilmStrip },
+	] as const;
+	const labels = Object.fromEntries(tools.map(({ id, label }) => [id, label])) as Record<Tool, string>;
+	const ready = duration > 0;
+	const openInspector = (section: EditorEffectSection) => {
+		setAdvanced(false);
+		setInspector(section);
+		setClipsOpen(false);
+	};
+	const closePanel = (restoreFocus = false) => {
+		setInspector(null);
+		setClipsOpen(false);
+		if (restoreFocus) railRef.current?.querySelector<HTMLElement>('[aria-pressed="true"]')?.focus({ preventScroll: true });
+	};
+	const openClips = () => {
+		setInspector(null);
+		setClipsOpen(true);
+	};
+	const addAudio = () => void timelineRef.current?.addAudio(nextAudioTrack);
+	const lookEntrySection = settings.selectedCaptionId ? "caption" : "frame";
+	const summary = ({
+		trim: ready
+			? t("ui.cutRoom.clipDuration", "Screen clip · {{time}}", { time: formatPlaybackTime(duration) })
+			: t("ui.cutRoom.openClip", "Open a clip to edit"),
+		zoom: t("ui.cutRoom.zoomHint", "Adjust focus on the timeline"),
+		look: t("ui.cutRoom.lookHint", "Frame, background and tap effects"),
+		audio: t("ui.cutRoom.audioHint", "Mix this recording or add audio"),
+		clips: t("ui.cutRoom.clipsHint", "Append an original recording"),
+	})[active];
+	const action = {
+		trim: { label: t("ui.cutRoom.splitHere", "Split here"), apply: () => timelineRef.current?.splitClip() },
+		zoom: { label: t("ui.cutRoom.addZoom", "Add zoom"), apply: () => timelineRef.current?.addZoom() },
+		look: { label: t("ui.cutRoom.editLook", "Edit look"), apply: () => openInspector(lookEntrySection) },
+		audio: { label: t("ui.cutRoom.editAudio", "Audio settings"), apply: () => openInspector("audio") },
+		clips: { label: t("ui.cutRoom.addClip", "Add clip"), apply: openClips },
+	}[active];
+	const lookSection = inspector === "scene" || inspector === "frame" || inspector === "cursor" ||
+		inspector === "webcam" || inspector === "captions";
+	const lookTabs = [
+		{ id: "frame", label: t("settings.sections.frame", "Frame") },
+		{ id: "scene", label: t("settings.background.title", "Background") },
+		{ id: "cursor", label: t("settings.sections.cursor", "Cursor") },
+		{ id: "captions", label: t("settings.sections.captions", "Captions") },
+		{ id: "webcam", label: t("settings.sections.webcam", "Webcam") },
+	] as const;
+	const closeLabel = visiblePanel === "clips" ? t("editing.closeClips", "Close Clips") : t("common.actions.close", "Close");
+	const addAnnotationLabel = t("ui.cutRoom.addAnnotation", "Add annotation");
+	return (
+		<div className="cut-editor-tools">
+			<div className="cut-edit-dock">
+				<div className="cut-edit-timeline" inert={Boolean(visiblePanel)}>
+					{timelinePanel}
+					<section className="cut-tool-detail" aria-label={labels[active]}>
+						<div>
+							<h2>{labels[active]}</h2>
+							<p>{summary}</p>
+						</div>
+						{(active === "zoom" || (active === "trim" && settings.selectedClipId)) && (
+							<Button variant="ghost" className="cut-tool-action" disabled={!ready}
+								onPress={() => openInspector(active === "zoom" ? "zoom" : "clip")}>
+								{t("ui.settings", "Settings")}
+							</Button>
+						)}
+						<Button variant="ghost" className="cut-tool-action" disabled={!ready || (active === "trim" && !canSplit)} onPress={action.apply}>
+							{action.label}
+						</Button>
+					</section>
+				</div>
+				{visiblePanel && (
+					<section className="cut-inline-inspector" id={panelId} ref={panelRef}
+						tabIndex={-1} aria-labelledby={`${panelId}-heading`} data-cut-overlay
+						onKeyDown={(event) => {
+							if (event.key === "Escape" && !event.defaultPrevented && event.currentTarget.contains(event.target as Node)) {
+								event.preventDefault();
+								event.stopPropagation();
+								closePanel(true);
+							}
+						}}
+					>
+						<header className="cut-inspector-header">
+							<h2 id={`${panelId}-heading`}>{labels[visiblePanel]}</h2>
+							{(inspector !== "scene" && (lookSection || inspector === "zoom")) && (
+								<Button variant="ghost" aria-pressed={advanced} onPress={() => setAdvanced(!advanced)}>
+									{t("ui.advanced", "Advanced")}
+								</Button>
+							)}
+							{lookSection && (
+								<Button variant="ghost" size="icon" className="cut-icon-button" title={addAnnotationLabel}
+									onPress={() => {
+										timelineRef.current?.addAnnotation();
+										closePanel(true);
+									}}>
+									<Plus aria-hidden="true" />
+								</Button>
+							)}
+							{inspector === "audio" && (
+								<Button variant="ghost" onPress={() => {
+									closePanel(true);
+									addAudio();
+								}}>{t("ui.cutRoom.addAudio", "Add audio")}</Button>
+							)}
+							<Button variant="ghost" size="icon" className="cut-icon-button"
+								aria-label={closeLabel} data-cut-close onPress={() => closePanel(true)}>
+								<X aria-hidden="true" />
+							</Button>
+						</header>
+						{lookSection && (
+							<div className="cut-inspector-tabs" role="group" aria-label={labels.look}>
+								{lookTabs.map(({ id, label }) => (
+									<Button key={id} variant="ghost" aria-pressed={inspector === id}
+										onPress={() => setInspector(id)}>{label}</Button>
+								))}
+							</div>
+						)}
+						<div className="cut-inspector-scroll scroll-shadow scroll-shadow--vertical scroll-shadow--fade scroll-shadow--hide-scrollbar"
+							data-scroll-shadow-mode="auto" ref={scrollRef}>
+							{visiblePanel === "clips" ? clips : inspector !== null && (
+								<>
+									{inspector === "zoom" && (
+										<Button variant="ghost" className="cut-inspector-suggest" onPress={() => {
+											timelineRef.current?.suggestZooms();
+											closePanel(true);
+										}}>{t("ui.cutRoom.suggestZooms", "Suggest zooms")}</Button>
+									)}
+									{inspector === "audio" && !settings.selectedAudioId ? (
+										<label className="cut-preview-volume">
+											{t("editor.playback.volume", "Preview volume")}
+											<input type="range" min={0} max={1} step={0.01} value={previewVolume}
+												onChange={(event) => setPreviewVolume(Number(event.target.value))} />
+										</label>
+									) : (
+										<SettingsPanel {...settings} panelMode="cut-room" activeEffectSection={inspector} advanced={advanced} />
+									)}
+								</>
+							)}
+						</div>
+					</section>
+				)}
+			</div>
+			<nav ref={railRef} className="cut-tool-rail" aria-label={t("settings.sections.title", "Editor tools")}>
+				{tools.map(({ id, icon: Icon, label }) => (
+					<Button key={id} variant="ghost" className="cut-tool" aria-pressed={active === id}
+						aria-controls={visiblePanel === id ? panelId : undefined}
+						disabled={!ready}
+						onPress={() => {
+							if (visiblePanel === id) {
+								closePanel(true);
+								return;
+							}
+							if (id !== active) clearSelection();
+							setTool(id);
+							if (id === "clips") openClips();
+							else if (id === "look") openInspector(active === id ? lookEntrySection : "frame");
+							else if (id === "audio") openInspector("audio");
+							else closePanel();
+						}}>
+						<Icon className="size-[18px]" aria-hidden="true" />
+						<span>{label}</span>
+					</Button>
+				))}
+			</nav>
+		</div>
+	);
+}
