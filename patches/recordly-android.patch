new file mode 100644
index 0000000..5f36f73
--- /dev/null
+++ b/src/components/video-editor/layout/EditorSidebar.mobile.css
@@ -0,0 +1,124 @@
+/*
+ * Phone layout for the editor shell.
+ *
+ * The desktop top row is [rail + 320px inspector][preview]. At 411px that leaves
+ * the preview 19px wide (measured), so the video is invisible. On phones the
+ * inspector becomes a slide-over drawer and the preview keeps the full width
+ * beside the 64px rail. The drawer is closed by default and opened from a rail
+ * icon; a backdrop or the header close button dismisses it.
+ */
+/* The close affordance exists only in the phone drawer. */
+.editor-inspector-close {
+	display: none;
+}
+
+@media (max-width: 900px) {
+	.editor-sidebar {
+		position: relative;
+	}
+
+	.editor-sidebar .editor-inspector {
+		position: absolute;
+		left: 4rem;
+		top: 0;
+		bottom: 0.5rem;
+		z-index: 40;
+		width: min(320px, calc(100vw - 5rem));
+	}
+
+	.editor-sidebar[data-mobile-open="false"] .editor-inspector {
+		display: none;
+	}
+
+	.editor-sidebar-backdrop {
+		display: none;
+	}
+
+	.editor-sidebar[data-mobile-open="true"] .editor-sidebar-backdrop {
+		display: block;
+		position: fixed;
+		inset: 56px 0 0 0;
+		z-index: 35;
+		background: rgb(0 0 0 / 0.35);
+		border: 0;
+		padding: 0;
+	}
+
+	/* Keep the rail above the backdrop so another section can be chosen
+	   without closing the drawer first. */
+	.editor-sidebar nav {
+		position: relative;
+		z-index: 36;
+	}
+
+	.editor-inspector-close {
+		display: inline-flex;
+	}
+
+	/* The desktop header uses two fixed grid columns (7px + 360px); at phone
+	   width the project group was clipped to 7px. Give the left group the
+	   remaining space and drop controls that only exist on desktop. */
+	.app-frame-header {
+		grid-template-columns: minmax(0, 1fr) auto !important;
+		padding-inline: 12px;
+		column-gap: 8px;
+	}
+
+	.app-frame-header .editor-header-start {
+		flex: 1 1 auto;
+		min-width: 0;
+	}
+
+	.app-frame-header .editor-header-title {
+		flex: 1 1 auto;
+		min-width: 0;
+	}
+
+	.app-frame-header .editor-header-title button {
+		display: block;
+		min-width: 0;
+		max-width: 100%;
+		max-height: 36px;
+		font-size: 12px;
+		line-height: 1.15;
+		white-space: normal;
+		overflow: hidden;
+		padding-inline: 4px;
+	}
+
+	/* The name lives in an upstream `truncate` span; allow two lines so a
+	   timestamp-named project is identifiable without hiding other actions. */
+	.app-frame-header .editor-header-title button > span {
+		display: -webkit-box;
+		-webkit-line-clamp: 2;
+		-webkit-box-orient: vertical;
+		white-space: normal !important;
+		overflow: hidden;
+		text-overflow: clip;
+		line-height: 1.15;
+		max-height: 28px;
+	}
+
+	/* Decorative breadcrumb separators cost 49px the project name needs. */
+	.app-frame-header .editor-header-start > span.mx-2,
+	.app-frame-header .editor-header-start > .separator {
+		display: none;
+	}
+
+	.app-frame-header .editor-header-end {
+		gap: 6px;
+	}
+
+	.app-frame-header [aria-label="Recordly account"] {
+		display: none;
+	}
+
+	.app-frame-header .button--secondary {
+		display: none;
+	}
+
+	.app-frame-header [aria-label="Feedback"] {
+		display: none;
+	}
+}
+
