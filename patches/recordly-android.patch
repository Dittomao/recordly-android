+	const [permissionError, setPermissionError] = useState<string>();
+	const [microphoneDenied, setMicrophoneDenied] = useState(false);
+	const [screenConfirmed, setScreenConfirmed] = useState(false);
+	const shown = useRef(false);
+	const pages = [
+		{
+			title: t("ui.tapswoopOnboarding.recordTitle", "Record any screen. Keep the good part."),
+			body: t(
+				"ui.tapswoopOnboarding.recordBody",
+				"TapSwoop captures your screen and microphone, then turns the take into a clean, shareable video. Everything stays on this phone.",
+			),
+		},
+		{
+			title: t("ui.tapswoopOnboarding.focusTitle", "The camera follows your taps."),
+			body: t(
+				"ui.tapswoopOnboarding.focusBody",
+				"Every tap gets a short, smooth zoom. Swipes and scrolling stay wide, so the screen keeps its context.",
+			),
+		},
+		{
+			title: t("ui.tapswoopOnboarding.cutTitle", "Cut it in the Cut Room."),
+			body: t(
+				"ui.tapswoopOnboarding.cutBody",
+				"Trim the wait, tune the focus, add a look or a voice track. Then export straight to your gallery.",
+			),
+		},
+		{
+			title: t("ui.tapswoopOnboarding.readyTitle", "Set up your first take."),
+			body: t(
+				"ui.tapswoopOnboarding.readyBody",
+				"Recording needs the microphone and screen sharing. Tap focus is required for automatic zooms.",
+			),
+		},
+	];
+	const current = pages[page];
+	const isLast = page === PAGE_COUNT - 1;
+	const readyToRecord = Boolean(
+		permissions.accessibility && permissions.microphone && screenConfirmed,
+	);
+	const brand = androidDisplayName || "TapSwoop";
+
+	const show = useCallback(() => {
+		shown.current = true;
+		setPermissionError(undefined);
+		setMicrophoneDenied(false);
+		setScreenConfirmed(false);
+		setPage(0);
+		setOpen(true);
+	}, []);
+	useEffect(() => {
+		const onRequest = () => show();
+		window.addEventListener(TAPSWOOP_ONBOARDING_EVENT, onRequest);
+		let timer: number | undefined;
+		let waitingForVisible = false;
+		const schedule = () => {
+			if (shown.current || waitingForVisible || timer !== undefined || hasSeenTour()) return;
