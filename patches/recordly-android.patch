+import { describe, expect, it } from "vitest";
+import { CURSOR_MOTION_PRESETS } from "./cursorMotionPresets";
+import { buildInteractionZoomSuggestions } from "./timeline/zoomSuggestionUtils";
+import type { ClipRegion, CursorTelemetryPoint } from "./types";
+import { ZOOM_DEPTH_SCALES } from "./types";
+import { clampFocusToScale } from "./videoPlayback/focusUtils";
+import { computeRegionStrength, getZoomRegionTiming } from "./videoPlayback/zoomRegionUtils";
+import {
+	TOUCH_DEFAULT_DURATION_MS,
+	TOUCH_TRAILING_RESERVE_MS,
+	TOUCH_WIDE_BEAT_MS,
+	TOUCH_ZOOM_LEAD_MS,
+	touchZoomDepth,
+	touchZoomParams,
+} from "./touchZoomPolicy";
+
+const click = (timeMs: number, cx = 0.5, cy = 0.5): CursorTelemetryPoint => ({
+	timeMs,
+	cx,
+	cy,
+	interactionType: "click",
+	mouseButton: 1,
+});
+
+const release = (timeMs: number, cx = 0.5, cy = 0.5): CursorTelemetryPoint => ({
+	timeMs,
+	cx,
+	cy,
+	interactionType: "mouseup",
+	mouseButton: 1,
+});
+
+function suggestions(
+	samples: CursorTelemetryPoint[],
+	totalMs: number,
+	touch = true,
+	options: { clipRegions?: ClipRegion[]; reservedSpans?: { start: number; end: number }[] } = {},
+) {
+	return buildInteractionZoomSuggestions({
+		cursorTelemetry: samples,
+		totalMs,
+		defaultDurationMs: 2000,
+		...options,
+		...touchZoomParams(touch),
+	});
+}
+
+describe("touch auto-zoom policy", () => {
+	it("shortens holds between taps rather than shifting their leads or overlapping", () => {
+		const samples = [
+			click(3000),
+			release(3080),
+			click(3920, 0.7, 0.7),
+			release(4000, 0.7, 0.7),
+			click(5100, 0.2, 0.4),
+			release(5180, 0.2, 0.4),
+		];
+		const result = suggestions(samples, 10_000);
+		expect(result.suggestions).toHaveLength(3);
+		for (const [index, region] of result.suggestions.entries()) {
+			const tap = [3000, 3920, 5100][index];
+			expect(region.start).toBe(tap - TOUCH_ZOOM_LEAD_MS);
+			expect(region.end - region.start).toBeGreaterThanOrEqual(800);
+			const envelope = { startMs: region.start, endMs: region.end, fitTransitions: true as const };
+			const preset = CURSOR_MOTION_PRESETS.focused;
+			const { zoomInEnd, zoomOutStart } = getZoomRegionTiming(envelope, preset);
+			expect(computeRegionStrength(envelope, tap, preset)).toBeGreaterThan(0.85);
+			expect(zoomOutStart).toBeGreaterThanOrEqual(zoomInEnd + 90);
+			expect(computeRegionStrength(envelope, (zoomInEnd + zoomOutStart) / 2, preset)).toBe(1);
+			expect(computeRegionStrength(envelope, region.end, preset)).toBe(0);
+			if (index > 0) {
+				expect(region.start - result.suggestions[index - 1].end).toBeGreaterThanOrEqual(
+					TOUCH_WIDE_BEAT_MS,
+				);
+			}
+		}
+	});
+
+	it("keeps a quick repeat on one target inside one camera visit", () => {
+		const result = suggestions(
+			[click(3000), release(3080), click(3350), release(3430)],
+			10_000,
+		);
+		expect(result.suggestions).toEqual([
+			{ start: 3000 - TOUCH_ZOOM_LEAD_MS, end: 3000 - TOUCH_ZOOM_LEAD_MS + TOUCH_DEFAULT_DURATION_MS, focus: { cx: 0.5, cy: 0.5 } },
+		]);
+	});
+
+	it("frames different targets when there is room for both moves, even inside the repeat window", () => {
+		const result = suggestions(
+			[click(3000, 0.25), release(3080, 0.25), click(3730, 0.75), release(3810, 0.75)],
+			10_000,
+		);
+		expect(result.suggestions).toEqual([
+			{
+				start: 3000 - TOUCH_ZOOM_LEAD_MS,
+				end: 3730 - TOUCH_ZOOM_LEAD_MS - TOUCH_WIDE_BEAT_MS,
+				focus: { cx: 0.25, cy: 0.5 },
+			},
+			{
+				start: 3730 - TOUCH_ZOOM_LEAD_MS,
+				end: 3730 - TOUCH_ZOOM_LEAD_MS + TOUCH_DEFAULT_DURATION_MS,
+				focus: { cx: 0.75, cy: 0.5 },
+			},
+		]);
+	});
+
+	it("does not let a late tap erase an earlier visit that fits before the cut", () => {
+		const result = suggestions(
+			[click(9050), release(9130), click(9750), release(9830)],
+			10_000,
+		);
+		expect(result.suggestions).toEqual([
+			{ start: 9050 - TOUCH_ZOOM_LEAD_MS, end: 9640, focus: { cx: 0.5, cy: 0.5 } },
+		]);
+	});
+
+	it("frames neighboring taps without crossing an existing zoom or replacing it", () => {
+		const result = suggestions(
+			[click(3550), release(3630), click(4500), release(4580), click(5130), release(5210)],
+			10_000,
+			true,
+			{ reservedSpans: [{ start: 4080, end: 5000 }] },
+		);
+		expect(result.suggestions.map(({ start, end }) => ({ start, end }))).toEqual([
+			{ start: 3550 - TOUCH_ZOOM_LEAD_MS, end: 4080 },
+			{ start: 5000, end: 5000 + TOUCH_DEFAULT_DURATION_MS },
+		]);
+	});
+
+	it("uses timeline time for sped-up clips and leaves cut-away taps out", () => {
+		const result = suggestions(
+			[click(1000), release(1080), click(4800), release(4880)],
+			5000,
+			true,
+			{ clipRegions: [{ id: "clip", startMs: 1000, endMs: 4000, sourceStartMs: 4000, speed: 2 }] },
+		);
+		expect(result.suggestions).toEqual([
+			{
+				start: 1400 - TOUCH_ZOOM_LEAD_MS,
+				end: 1400 - TOUCH_ZOOM_LEAD_MS + TOUCH_DEFAULT_DURATION_MS,
+				focus: { cx: 0.5, cy: 0.5 },
+			},
+		]);
+	});
+
+	it("starts a touch region shortly before the tap with a crisp duration", () => {
+		const samples = [click(3000), release(3080), click(7000), release(7080)];
+		const result = suggestions(samples, 12_000);
+		expect(result.suggestions).toHaveLength(2);
+		for (const [index, region] of result.suggestions.entries()) {
+			const tap = [3000, 7000][index];
+			expect(Math.abs(region.start - (tap - TOUCH_ZOOM_LEAD_MS))).toBeLessThanOrEqual(1);
+			expect(region.end - region.start).toBe(TOUCH_DEFAULT_DURATION_MS);
+		}
+	});
+
+	it("keeps the desktop merge gap and centred lead when the host is not touch", () => {
+		const samples = [
+			click(3000),
+			release(3080),
+			click(4500),
+			release(4580),
+			click(6000),
+			release(6080),
+		];
+		expect(suggestions(samples, 10_000, false).suggestions).toHaveLength(1);
+		const isolated = suggestions([click(5000), release(5080)], 10_000, false);
+		expect(isolated.suggestions[0].start).toBe(4000);
+	});
+
+	it("ignores swipe movement with no tap", () => {
+		const samples: CursorTelemetryPoint[] = [
+			{ timeMs: 1000, cx: 0.5, cy: 0.7, interactionType: "move" },
+			{ timeMs: 1300, cx: 0.5, cy: 0.55, interactionType: "move" },
+			{ timeMs: 1600, cx: 0.5, cy: 0.4, interactionType: "move" },
