+	start: number;
+	end: number;
+};
+
+/**
+ * Keep the approach anchored to the tap and buy room by shortening the prior
+ * hold instead. Cuts and existing zooms are hard boundaries. A tap too close
+ * to an ending keeps its ripple without starting a move that cannot return.
+ */
+function scheduleTouchSuggestions(
+	groups: InteractionGroup[],
+	reserved: { start: number; end: number }[],
+	totalMs: number,
+	defaultDurationMs: number,
+	mergeGapMs: number,
+	timing: NonNullable<TouchZoomParams["touchTiming"]>,
+): SuggestedZoomRegion[] {
+	const suggestions: SuggestedZoomRegion[] = [];
+	for (const group of groups) {
+		const scheduleSlot = (start: number, end: number) => {
+			if (start >= end) return;
+			const clusters: { firstMs: number; lastMs: number; focus: ZoomFocus }[] = [];
+			for (const tap of group.candidates) {
+				const down = tap.centerTimeMs;
+				const up = tap.endTimeMs ?? down;
